# =========================================
# CivicPulse Environment Configuration
# =========================================

# Flask Secret Key (replace with a secure random key in production)
SECRET_KEY=civicpulse-secret-key-change-in-production-2026

# Flask Debug Mode (True for development, False for production)
FLASK_DEBUG=True

# Oracle Database Connection
# Format: localhost:1521/FREEPDB1 or host:port/service_name
ORACLE_USER=system
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_DSN=localhost:1521/FREEPDB1

# SMTP Email Configuration (Optional - for Day 20 email notifications)
# Leave blank to run with local delivery logging (graceful fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@civicpulse.com
SMTP_FROM_NAME=CivicPulse Admin

